                    </div>
                    <div class="p-4">
                        <h5 class="mb-1 fw-bold">Ph.D. Laura Castillo</h5>
                        <small class="text-primary fw-bold">Política Económica</small>
                        <p class="mt-3 text-muted" style="font-size: 0.9rem;">Especialista en economía del sector público, impuestos y análisis de impacto de políticas gubernamentales.</p>
                    </div>
                    <div class="d-flex justify-content-center bg-light p-3 border-top">
                        <a class="btn btn-sm-square btn-outline-primary mx-1" href="#"><i class="fab fa-linkedin-in"></i></a>
                        <a class="btn btn-sm-square btn-outline-primary mx-1" href="#"><i class="fa fa-envelope"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Docente Profile -->
<div id="modalPerfilDocente" class="modal" style="display: none;">
    <div class="modal-content">
        <span class="close" onclick="cerrarModal()">&times;</span>
        <div id="perfilDocenteContainer"></div>
    </div>
</div>

<style is:global>
    /* Modal Styles */
    .modal {
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .modal-content {
        background-color: #fefefe;
        padding: 20px;
        border-radius: 10px;
        width: 80%;
        max-width: 600px;
        box-shadow: 0px 0px 10px 2px rgba(0, 0, 0, 0.2);
    }

    .close {
        color: #aaaaaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
    }

    .close:hover,
    .close:focus {
        color: #000;
        text-decoration: none;
        cursor: pointer;
    }
</style>

<script is:inline>
    // JavaScript para abrir el modal con la información del docente
    function mostrarPerfil(docenteId) {
        fetch(`/api/docente/${docenteId}`)
            .then(response => response.json())
            .then(data => {
                // Crear contenido dinámico para el modal con la información del docente
                const perfilContainer = document.getElementById('perfilDocenteContainer');
                perfilContainer.innerHTML = `
                    <div style="font-size: 18px;">
                        <h3>${data.nombre} ${data.apellido}</h3>
                        <p><strong>Tipo de Usuario:</strong> ${data.tipo_usuario}</p>
                        <p><strong>Carrera:</strong> ${data.carrera}</p>
                        <p><strong>Redes Educativas:</strong> ${data.redes_educativas ? data.redes_educativas : 'No disponible'}</p>
                        <p><strong>Artículos Publicados:</strong> ${data.articulos_publicados ? data.articulos_publicados : 'No disponible'}</p>
                        <p><strong>Materias que Imparte:</strong> ${data.materias.length ? data.materias.join(', ') : 'No disponible'}</p>
                    </div>
                `;
                document.getElementById('modalPerfilDocente').style.display = 'flex';
            })
            .catch(error => console.error('Error al obtener la información del docente:', error));
    }

    // JavaScript para cerrar el modal
    function cerrarModal() {
        document.getElementById('modalPerfilDocente').style.display = 'none';
    }
</script>
</Layout>
