---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Docentes">
<!-- Header Start -->
<div class="container-fluid bg-primary py-5 mb-5 page-header">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-10 text-center">
                <h1 class="display-3 text-white animated slideInDown">Docentes</h1>
            </div>
        </div>
    </div>
</div>
<!-- Header End -->

<!-- Section Title for Docentes -->
<div class="container text-center py-3">
    <h2 class="display-5 text-primary mb-2">Nuestros Docentes</h2>
</div>

<!-- Section for Cards of Docentes -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-4">
            <!-- Docente 1 -->
            <div class="col-lg-4 col-md-6 col-sm-12">
                <div class="team-item bg-white text-center rounded overflow-hidden shadow-sm" style="transition: all 0.3s ease; border: 1px solid #eee;">
                    <div class="overflow-hidden" style="height: 280px;">
                        <img class="img-fluid w-100 h-100" style="object-fit: cover; transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.1)';" onmouseout="this.style.transform='scale(1)';" src="https://images.unsplash.com/photo-1568602471122-7832951cc4c5?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="Profesor">
                    </div>
                    <div class="p-4">
                        <h5 class="mb-1 fw-bold">Dr. Roberto Salazar</h5>
                        <small class="text-primary fw-bold">Economía Internacional</small>
                        <p class="mt-3 text-muted" style="font-size: 0.9rem;">Doctorado en Macroeconomía. Especialista en mercados emergentes y políticas de comercio internacional.</p>
                    </div>
                    <div class="d-flex justify-content-center bg-light p-3 border-top">
                        <a class="btn btn-sm-square btn-outline-primary mx-1" href="#"><i class="fab fa-linkedin-in"></i></a>
                        <a class="btn btn-sm-square btn-outline-primary mx-1" href="#"><i class="fa fa-envelope"></i></a>
                    </div>
                </div>
            </div>

            <!-- Docente 2 -->
