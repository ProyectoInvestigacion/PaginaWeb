---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Ejercicios">
<!-- Section Title based on selected career and subject -->
<div class="container text-center py-3">
    <!-- Main Title -->
    <h2 class="display-5 text-primary mb-2">
        Todas las Carreras
    </h2>
    <!-- Subtitle -->
    <h4 class="text-secondary mb-4">
        Todas las Materias
    </h4>
</div>
<!-- Section Title ends -->

<!-- Section for Filters -->
<div class="container mb-4">
    <form id="filtro-ejercicios" method="GET" action="ejercicios_estudiantes.html">
        <div class="row g-2 align-items-center">
            <!-- Filter for Career -->
            <div class="col-md-5">
                <label for="filtro-carrera" class="form-label">Carrera:</label>
                <select class="form-select" id="filtro-carrera" name="carrera" onchange="this.form.submit()">
                    <option value="" selected disabled>Selecciona una carrera</option>

                </select>
            </div>
            <!-- Filter for Subject -->
            <div class="col-md-5">
                <label for="filtro-materia" class="form-label">Materia:</label>
                <select class="form-select" id="filtro-materia" name="materia" onchange="this.form.submit()">
                    <option value="" selected disabled>Selecciona una materia</option>

                </select>
            </div>
        </div>
    </form>
</div>
<!-- Section ends for Filters -->

<!-- Section for Exercise Cards in Grid Format -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-4">
            <!-- Loop to display the filtered resources -->

                <!-- Message if no resources are available -->
                <div class="col-lg-12 text-center">
                    <p class="text-secondary">No hay ejercicios disponibles para los filtros seleccionados.</p>
                </div>

        </div>
    </div>
</div>

<!-- Section ends for Exercise Cards -->
</Layout>
