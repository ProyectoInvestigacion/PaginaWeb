---
import Layout from '../layouts/Layout.astro';
---

<Layout title="FCE-UCE | Facultad de Ciencias Económicas">
<!-- Contenedor del Carrusel de Presentación -->
<div class="video-section">
    <div id="headerCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="3000" style="height: clamp(240px, 60vh, 640px); background-color: #f8f9fa; overflow: hidden;">
        <!-- Indicadores -->
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#headerCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#headerCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#headerCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>

        <!-- Slides -->
        <div class="carousel-inner h-100">
            <!-- Slide 1 -->
            <div class="carousel-item active h-100 d-flex justify-content-center align-items-center">
                <img class="d-block w-100 h-100" style="object-fit: cover;" src="https://images.unsplash.com/photo-1541339907198-e08756dedf3f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80" alt="Universidad">
                <div class="carousel-caption d-none d-md-block" style="background: rgba(0,0,0,0.5); border-radius: 10px; padding: 20px;">
                    <h2 class="text-white fw-bold">Facultad de Ciencias Económicas</h2>
                    <p class="text-white-50">Formando líderes en Economía, Finanzas y Estadística.</p>
                </div>
            </div>

            <!-- Slide 2 -->
            <div class="carousel-item h-100 d-flex justify-content-center align-items-center">
                <img class="d-block w-100 h-100" style="object-fit: cover;" src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80" alt="Finanzas" loading="lazy">
                <div class="carousel-caption d-none d-md-block" style="background: rgba(0,0,0,0.5); border-radius: 10px; padding: 20px;">
                    <h2 class="text-white fw-bold">Recursos Académicos</h2>
                    <p class="text-white-50">Accede a la mejor biblioteca de material de estudio gratuito.</p>
                </div>
            </div>

            <!-- Slide 3 -->
            <div class="carousel-item h-100 d-flex justify-content-center align-items-center">
                <img class="d-block w-100 h-100" style="object-fit: cover;" src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80" alt="Estadística" loading="lazy">
                <div class="carousel-caption d-none d-md-block" style="background: rgba(0,0,0,0.5); border-radius: 10px; padding: 20px;">
                    <h2 class="text-white fw-bold">Herramientas Modernas</h2>
                    <p class="text-white-50">Descubre nuestros simuladores financieros y chatbots impulsados por IA.</p>
                </div>
            </div>
        </div>

        <!-- Controles -->
        <button class="carousel-control-prev" type="button" data-bs-target="#headerCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Anterior</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#headerCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Siguiente</span>
        </button>
    </div>
</div>

<!-- Service Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="service-item text-center pt-3">
                    <div class="p-4">
                        <i class="fa fa-3x fa-graduation-cap text-primary mb-4"></i>
                        <h5 class="mb-3">Docentes Expertos</h5>
                        <p>Aprende de docentes especializados en diferentes áreas como Economía, Finanzas y Estadística
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.3s">
                <div class="service-item text-center pt-3">
                    <div class="p-4">
                        <i class="fa fa-3x fa-globe text-primary mb-4"></i>
                        <h5 class="mb-3">Acceso Global</h5>
                        <p>Accede desde cualquier lugar y desde cualquier dispositivo con acceso a internet a los
                            recursos educativos</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.5s">
                <div class="service-item text-center pt-3">
                    <div class="p-4">
                        <i class="fa fa-3x fa-home text-primary mb-4"></i>
                        <h5 class="mb-3">Proyectos y Ejercicios</h5>
                        <p>Desarrolla tus habilidades resolviendo ejercicios prácticos que te ayudarán en tus
                            evaluaciones.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.7s">
                <div class="service-item text-center pt-3">
                    <div class="p-4">
                        <i class="fa fa-3x fa-book-open text-primary mb-4"></i>
                        <h5 class="mb-3">Biblioteca de Recursos</h5>
                        <p>Explora una biblioteca de PDFs, videos y guías especializadas para complementar tu estudio y
                            reforzar tus conocimientos.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Service End -->

<!-- About Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.1s" style="min-height: 400px;">
                <div class="position-relative h-100">
                    <img class="img-fluid position-absolute w-100 h-100"
                        src="static/img/logo_uce.png" alt="" style="object-fit: cover;">
                </div>
            </div>
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.3s">
                <h6 class="section-title bg-white text-start text-primary pe-3">Nosotros</h6>
                <h1 class="mb-4">Bienvenidos a FCE-UCE</h1>
                <p class="mb-4">En nuestra plataforma, ofrecemos una experiencia de aprendizaje diseñada específicamente
                    para los estudiantes de la Facultad de Economía. Contamos con recursos interactivos, como ejercicios
                    resueltos, videos explicativos y un chatbot especializado, para facilitar la comprensión de materias
                    clave como Economía, Finanzas y Estadística.</p>
                <p class="mb-4">Nuestro objetivo es ayudar a mejorar el rendimiento académico de los estudiantes,
                    proporcionándoles acceso a contenidos de calidad y herramientas útiles que apoyen su aprendizaje.
                </p>
                <div class="row gy-2 gx-4 mb-4">
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Docentes Experimentados</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Acceso Total y Gratuito</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Materiales de Estudio
                            Organizados</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Ejercicios Resueltos</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Videos Explicativos</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Chatbots Especializados</p>
                    </div>
                </div>
                <a class="btn btn-primary py-3 px-5 mt-2" href="pages/recursos.html">Leer Más</a>
            </div>
        </div>
    </div>
</div>
<!-- About End -->

<!-- Recursos Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
            <h6 class="section-title bg-white text-center text-primary px-3">Recursos</h6>
            <h1 class="mb-5">Recursos Populares</h1>
        </div>
        <div class="row g-4 justify-content-center">
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="course-item bg-light">
                    <div class="position-relative overflow-hidden">
                        <img class="img-fluid" src="static/img/logo_uce.png"
                            alt="Recursos de Economía">
                        <div class="w-100 d-flex justify-content-center position-absolute bottom-0 start-0 mb-4">
                            <a href="pages/recursos.html"
                                class="flex-shrink-0 btn btn-sm btn-primary px-3 border-end"
                                style="border-radius: 30px;">Ver más</a>
                        </div>
                    </div>
                    <div class="text-center p-4 pb-0">
                        <h3 class="mb-0">Economía</h3>
                        <div class="mb-3">
                            <small>(Recursos)</small>
                        </div>
                        <h5 class="mb-4">PDFs, Videos, Ejercicios</h5>
                    </div>
                    <div class="d-flex border-top">
                        <small class="flex-fill text-center border-end py-2"><i
                                class="fa fa-book text-primary me-2"></i>PDFs</small>
                        <small class="flex-fill text-center border-end py-2"><i
                                class="fa fa-video text-primary me-2"></i>Videos</small>
                        <small class="flex-fill text-center py-2"><i
                                class="fa fa-file-alt text-primary me-2"></i>Ejercicios</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
                <div class="course-item bg-light">
                    <div class="position-relative overflow-hidden">
                        <img class="img-fluid" src="static/img/logo_uce.png"
                            alt="Recursos de Finanzas">
                        <div class="w-100 d-flex justify-content-center position-absolute bottom-0 start-0 mb-4">
                            <a href="pages/recursos.html"
                                class="flex-shrink-0 btn btn-sm btn-primary px-3 border-end"
                                style="border-radius: 30px;">Ver más</a>
                        </div>
                    </div>
                    <div class="text-center p-4 pb-0">
                        <h3 class="mb-0">Finanzas</h3>
                        <div class="mb-3">
                            <small>(Recursos)</small>
                        </div>
                        <h5 class="mb-4">PDFs, Videos, Ejercicios</h5>
                    </div>
                    <div class="d-flex border-top">
                        <small class="flex-fill text-center border-end py-2"><i
                                class="fa fa-book text-primary me-2"></i>PDFs</small>
                        <small class="flex-fill text-center border-end py-2"><i
                                class="fa fa-video text-primary me-2"></i>Videos</small>
                        <small class="flex-fill text-center py-2"><i
                                class="fa fa-file-alt text-primary me-2"></i>Ejercicios</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.5s">
                <div class="course-item bg-light">
                    <div class="position-relative overflow-hidden">
                        <img class="img-fluid" src="static/img/logo_uce.png"
                            alt="Recursos de Estadística">
                        <div class="w-100 d-flex justify-content-center position-absolute bottom-0 start-0 mb-4">
                            <a href="pages/recursos.html"
                                class="flex-shrink-0 btn btn-sm btn-primary px-3 border-end"
                                style="border-radius: 30px;">Ver más</a>
                        </div>
                    </div>
                    <div class="text-center p-4 pb-0">
                        <h3 class="mb-0">Estadística</h3>
                        <div class="mb-3">
                            <small>(Recursos)</small>
                        </div>
                        <h5 class="mb-4">PDFs, Videos, Ejercicios</h5>
                    </div>
                    <div class="d-flex border-top">
                        <small class="flex-fill text-center border-end py-2"><i
                                class="fa fa-book text-primary me-2"></i>PDFs</small>
                        <small class="flex-fill text-center border-end py-2"><i
                                class="fa fa-video text-primary me-2"></i>Videos</small>
                        <small class="flex-fill text-center py-2"><i
                                class="fa fa-file-alt text-primary me-2"></i>Ejercicios</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Recursos End -->

<!--Script de eventos init -->
<!-- Recarga la página si el usuario intenta acceder a una página anterior desde la caché, asegurando que la sesión se mantenga actualizada. -->
<script is:inline>
    window.addEventListener('pageshow', function(event) {
        if (event.persisted) {
            window.location.reload();
        }
    });
</script>
<!-- Script de eventos end -->
</Layout>
